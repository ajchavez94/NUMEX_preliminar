library(ggplot2)
library(broom.mixed)
library(dplyr)
coefs <- tidy(
mod_N_cr,
effects = "fixed",
conf.int = TRUE,
conf.level = 0.95
) %>%
filter(term != "(Intercept)")
coefs <- coefs %>%
mutate(
sig = case_when(
p.value < 0.001 ~ "***",
p.value < 0.01  ~ "**",
p.value < 0.05  ~ "*",
TRUE            ~ ""
)
)
ggplot(coefs, aes(x = term, y = estimate)) +
geom_point(size = 3) +
geom_errorbar(
aes(ymin = conf.low, ymax = conf.high),
width = 0.15
) +
geom_text(
aes(label = sig, y = conf.high),
vjust = -0.6,
size = 5)+
geom_hline(yintercept = 0, linetype = "dashed", color = "grey40") +
labs(
x = "Sub",
y = "Estimate (± 95% CI)"
) +
theme_bw()
coefs$term <- gsub("^Sub", "", coefs$term)
#library(dotwhisker)
#dwplot(mod_iWUE_pt, conf.level = 0.95) +
#  theme_bw()
plot_model(mod_iWUE_pt, title="Pouteria torta", axis.title="Coefficient", show.values = TRUE, value.offset = .3)
plot_model(mod_iWUE_al, title="Alchornea lojaensis", axis.title="Coefficient", show.values = TRUE, value.offset = .3)
plot_model(mod_iWUE_cr, title="Clarisia racemosa", axis.title="Coefficient", show.values = TRUE, value.offset = .3)
plot_model(mod_iWUE_my, title="Myrcia", axis.title="Coefficient", show.values = TRUE, value.offset = .3)
plot_model(mod_iWUE_hp, title="Hedyosmum", axis.title="Coefficient", show.values = TRUE, value.offset = .3)
plot_model(mod_iWUE_wl, title="Weinmania", axis.title="Coefficient", show.values = TRUE, value.offset = .3)
plot_diagnostics <- function(model, model_name) {
res <- residuals(model)#residual
fit <- fitted(model) #model
par(mfrow = c(1, 2)) #graph
# Residuals vs Fitted
plot(fit, res,
xlab = "Fitted values",
ylab = "Residuals",
main = paste(model_name, "\nResiduals vs Fitted"))
abline(h = 0, col = "red", lty = 2)
# QQ plot
qqnorm(res, main = paste(model_name, "\nNormal Q-Q"))
qqline(res, col = "red", lty = 2)
par(mfrow = c(1, 1))
}
#apply the plot_diagnostics_to_all
pdf("model_diagnostics_species.pdf", width = 10, height = 5)
for (nm in names(models)) {
plot_diagnostics(models[[nm]], nm)
}
dev.off()
# Run and plot
for (nm in names(models)) {
cat("\n", nm, "\n")
res <- simulateResiduals(models[[nm]], n = 1000)
plot(res, main = nm)
}
testUniformity(res)
testDispersion(res)
testOutliers(res)
pdf("DHARMa_diagnostics_species.pdf", width = 9, height = 7)
for (nm in names(models)) {
res <- simulateResiduals(models[[nm]], n = 1000)
plot(res, main = nm)
}
dev.off()
