#install.packages("effects")
library("effects")
m <- lmer(`iWUE (μmol/mol)`~ SUB+(1|Bloque),data=datos_Weinmania, REML=TRUE)
e <- allEffects(m)
print(e)
# allEffects() returns a list, but for our model (where everything can interact with everything), there's only one element
e1 <- e[[1]]
e.df <- as.data.frame(e1)
library(ggplot2)
g <- ggplot(e.df,aes(x=SUB,y=fit,ymin=lower,ymax=upper)) +
geom_pointrange(position=position_dodge(width=.1)) +
xlab("SUB") + ylab("iWUE") + ggtitle("Effect of Recipe and Temperature on Breaking Angle")
plot(g)
