y = fit,
ymin = lower,
ymax = upper,
color = SUB
)
) +
geom_pointrange(
position = position_dodge(width = 0.1),
size = 0.8
) +
scale_color_manual(values = sub_colors) +
labs(
x = "Treatment",
y = "Predicted value",
title = title_name,
color = "SUB"
) +
theme_bw() +
theme(
plot.title = element_text(
hjust = 0.5,
face = "bold"
),
axis.text = element_text(size = 10),
axis.title = element_text(size = 11),
legend.position = "right"
)
return(g)
}
# =========================================================
# Generate all plots
# =========================================================
plot_list <- lapply(
names(models_leaf),
function(name){
model <- models_leaf[[name]]
plot_effects(
model = model,
title_name = name
)
}
)
# =========================================================
# Arrange in 6 rows x 3 columns
# =========================================================
final_plot <- wrap_plots(
plot_list,
ncol = 3,
nrow = 6
)
# Display
final_plot
# =========================================================
# Display plots
# =========================================================
# =========================================================
# OPTIONAL: Save all plots
# =========================================================
ggsave(
"all_leaf_effects.png",
wrap_plots(plot_list),
width = 18,
height = 20,
dpi = 300
)
