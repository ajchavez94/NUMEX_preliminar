#      TRUE ~ NA_real_
#    )
#  )
datos_myrcia <- datos_myrcia[!is.nan(datos_myrcia$`δ18O in ‰ vs DeltaSMOW`), ]
anova_model_15N_m <- aov(`δ15N (‰ v.s.AIR)` ~ N * P, data = datos_myrcia)
anova_model_18O_m <- aov(`δ18O in ‰ vs DeltaSMOW` ~ N * P, data = datos_myrcia)
anova_model_iWUE_m <- aov(`iWUE (μmol/mol)` ~ N * P, data = datos_myrcia)
anova_model_CN_m <- aov(`Narea` ~ N * P, data = datos_myrcia)
#### Cajanuma #####
### Weinmania ####
## For Weinmania. No significant effect on iWUE, marginal effect of P. Lower iWUE in P than C. Then for 18O and 15N no difference between treatments.
datos_Weinmania <- data %>%
filter(data$genus == "Weinmania")
anova_model_15N_Wl<- aov(`δ15N (‰ v.s.AIR)` ~ N * P, data = datos_Weinmania)
anova_model_18O_Wl <- aov(`δ18O in ‰ vs DeltaSMOW` ~ N * P, data = datos_Weinmania)
anova_model_iWUE_Wl <- aov(`iWUE (μmol/mol)` ~ N * P, data = datos_Weinmania)
anova_model_CN_Wl <- aov(`Narea` ~ N * P, data = datos_Weinmania)
### Hedyosmum purpurascens ####
datos_Hp <- data %>%
filter(data$genus == "Hedyosmun")
anova_model_15N_Hp <- aov(`δ15N (‰ v.s.AIR)` ~ N * P, data = datos_Hp)
anova_model_18O_Hp <- aov(`δ18O in ‰ vs DeltaSMOW` ~ N * P, data = datos_Hp)
anova_model_iWUE_Hp <- aov(`iWUE (μmol/mol)` ~ N * P, data = datos_Hp)
anova_model_CN_Hp <- aov(`Narea` ~ N * P, data = datos_Hp)
#Hedyosmum, no significant effect of any nutrient on these ecophysiological parameters.
mods_1000 <- list(
"Pouteria iWUE" = anova_model_iWUE,
"δ18O" = anova_model_18O,
"δ15N" = anova_model_15N,
"C:N"  = anova_model_CN,
"Clarisia iWUE " = anova_model_iWUE_cr,
"δ18O" = anova_model_18O_cr,
"δ15N" = anova_model_15N_cr,
"C:N"  = anova_model_CN_cr
)
modelsummary(
mods_1000,
statistic = "({statistic}, p = {p.value})",
stars = c('*' = .05, '**' = .01, '***' = .001),
fmt = 2,
output = "markdown",
title = "ANOVA results for *1000 species*")
mods_2000 <- list(
"Alchornea iWUE" = anova_model_iWUE_al,
"δ18O" = anova_model_18O_al,
"δ15N" = anova_model_15N_al,
"C:N"  = anova_model_CN_al,
"Myrcia iWUE " = anova_model_iWUE_m,
"δ18O" = anova_model_18O_m,
"δ15N" = anova_model_15N_m,
"C:N"  = anova_model_CN_m
)
modelsummary(
mods_2000,
statistic = "({statistic}, p = {p.value})",
stars = c('*' = .05, '**' = .01, '***' = .001),
fmt = 2,
output = "markdown",
title = "ANOVA results for 2000 species*")
#### Cajanuma #####
### Weinmania ####
## For Weinmania. No significant effect on iWUE, marginal effect of P. Lower iWUE in P than C. Then for 18O and 15N no difference between treatments.
datos_Weinmania <- data %>%
filter(data$genus == "Weinmania")
anova_model_15N_Wl<- aov(`δ15N (‰ v.s.AIR)` ~ N * P, data = datos_Weinmania)
anova_model_18O_Wl <- aov(`δ18O in ‰ vs DeltaSMOW` ~ N * P, data = datos_Weinmania)
anova_model_iWUE_Wl <- aov(`iWUE (μmol/mol)` ~ N * P, data = datos_Weinmania)
