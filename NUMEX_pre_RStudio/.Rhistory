p3_iWUE <- plot_coefs(mod_iWUE_my, "M. sp",color="#458B74")
p4_iWUE <- plot_coefs(mod_iWUE_al, "A. lojaensis",color="#458B74")
p5_iWUE <- plot_coefs(mod_iWUE_hp, "H. purpurascens",color="#458B74")
p6_iWUE <- plot_coefs(mod_iWUE_wl, "W. loxensis",color="#458B74")
p1_Narea <- plot_coefs(mod_Narea_pt, "P.torta",color="#458B00")
p2_Narea <- plot_coefs(mod_Narea_cr, "C. racemosa",color="#458B00")
p3_Narea <- plot_coefs(mod_Narea_my, "M. sp",color="#458B00")
p4_Narea <- plot_coefs(mod_Narea_al, "A. lojaensis",color="#458B00")
p5_Narea <- plot_coefs(mod_Narea_hp, "H. purpurascens",color="#458B00")
p6_Narea <- plot_coefs(mod_Narea_wl, "W. loxensis",color="#458B00")
p1_Parea <- plot_coefs(mod_Parea_pt, "P.torta",color="#CD5B45")
p2_Parea <- plot_coefs(mod_Parea_cr, "C. racemosa",color="#CD5B45")
p3_Parea <- plot_coefs(mod_Parea_my, "M. sp",color="#CD5B45")
p4_Parea <- plot_coefs(mod_Parea_al, "A. lojaensis",color="#CD5B45")
p5_Parea <- plot_coefs(mod_Parea_hp, "H. purpurascens",color="#CD5B45")
p6_Parea <- plot_coefs(mod_Parea_wl, "W. loxensis",color="#CD5B45")
p1_SLA <- plot_coefs(mod_SLA_pt, "P. torta",color="#CD661D")
p2_SLA <- plot_coefs(mod_SLA_cr, "C. racemosa",color="#CD661D")
p3_SLA <- plot_coefs(mod_SLA_my, "M. sp",color="#CD661D")
p4_SLA <- plot_coefs(mod_SLA_al, "A. lojaensis",color="#CD661D")
p5_SLA <- plot_coefs(mod_SLA_hp, "H. purpurascens",color="#CD661D")
p6_SLA <- plot_coefs(mod_SLA_wl, "W. loxensis",color="#CD661D")
(p1_iWUE  | p2_iWUE  | p3_iWUE  | p4_iWUE  | p5_iWUE  | p6_iWUE)/
(p1_Narea | p2_Narea | p3_Narea | p4_Narea | p5_Narea | p6_Narea) /
(p1_Parea | p2_Parea | p3_Parea | p4_Parea | p5_Parea | p6_Parea) /
(p1_SLA  | p2_SLA  | p3_SLA  | p4_SLA  | p5_SLA  | p6_SLA)
mod_iwue_narea_pt = lmer(`iWUE (μmol/mol)`~ N_area+SUB +(1|Bloque), data = datos_Pouteria)
