filter(data$genus == "Pouteria")
datos_Pouteria_filtered <- datos_Pouteria[datos_Pouteria$`iWUE (μmol/mol)` < 100, ]
anova_model_iWUE <- aov(`iWUE (μmol/mol)` ~ N * P, data = datos_Pouteria_filtered)#keep all the rest
anova_model_18O <- aov(`δ18O in ‰ vs DeltaSMOW` ~ N * P, data = datos_Pouteria)
anova_model_15N <- aov(`δ15N (‰ v.s.AIR)` ~ N * P, data = datos_Pouteria)
anova_model_CN <- aov(`Narea` ~ N * P, data = datos_Pouteria)
#Diagnostico del modelo
#par(mfrow = c(2, 2))
#plot(anova_model_iWUE)
#par(mfrow = c(1, 1))
#### Bombuscaro ####
### Clarisia ####
datos_Clarisia <- data %>%
filter(data$genus == "Clarisia")
anova_model_15N_cr <- aov(`δ15N (‰ v.s.AIR)` ~ N * P, data = datos_Clarisia)
anova_model_18O_cr <- aov(`δ18O in ‰ vs DeltaSMOW` ~ N * P, data = datos_Clarisia)
anova_model_iWUE_cr <- aov(`iWUE (μmol/mol)` ~ N * P, data = datos_Clarisia)
anova_model_CN_cr <- aov(`Narea` ~ N * P, data = datos_Clarisia)
## Para la Clarisia,, no hay ninguna diferencia en iWUE. En 18O, un poco efecto de N pero hubieron muy pocas muestras para adelantar conclusiones. En N, incrementa 18O. Transpira mas.In this case N has an effect on 15N for Clarisia.Lower 15N values in the N group.
##### San Francisco #######
## Alchornea ###
datos_al <- data %>%
filter(data$name == "Alchornea lojaensis")
datos_al<- datos_al%>% #the blocks change because there is a difference between.
mutate(
Bloque = case_when(
Plot %in% 1:4   ~ 1,
Plot %in% 6:9   ~ 2,
Plot %in% 11:14  ~ 3,
Plot %in% 16:19 ~ 4,
TRUE ~ NA_real_
)
)
datos_al <- datos_al[!is.nan(datos_al$`δ18O in ‰ vs DeltaSMOW`), ]
anova_model_15N_al <- aov(`δ15N (‰ v.s.AIR)` ~ N * P, data = datos_al)
anova_model_18O_al<- aov(`δ18O in ‰ vs DeltaSMOW` ~ N * P, data = datos_al)
anova_model_iWUE_al <- aov(`iWUE (μmol/mol)` ~ N * P, data = datos_al)
anova_model_CN_al <- aov(`Narea` ~ N * P, data = datos_al)
datos_myrcia <- data %>%
filter(data$name == "Myrcia sp nov")
#datos_myrcia<- datos_myrcia %>%
#  mutate(
#    Bloque = case_when(
#      Plot %in% 1:4   ~ 1,
#      Plot %in% 6:9   ~ 2,
