datos_long <- controles %>%
select(name, iWUE, "N:P", LNC, LPC) %>%
pivot_longer(
cols = c(iWUE,"N:P", LNC, LPC),
names_to = "Variable",
values_to = "Valor"
)
ggplot(datos_long, aes(name, Valor)) +
geom_boxplot() +
geom_jitter(width = 0.15, alpha = 0.6) +
facet_wrap(~ Variable, ncol = 2, scales = "free_y") +
theme_bw() +
theme(
axis.text.x = element_text(
angle = 45,
hjust = 1,
face = "italic"
)
) +
labs(x = "Species", y = NULL)
