limits_main <- list(
c(0, 110),    # fila 1 = iWUE
c(2, 3.5),   # loglNC
c(1.2, 4),   # Narea
c(-1, 0.8),  #logLPC
c(0, 0.8),     #Pärea
c(0, 30),
c(20, 140) #0
)
library(emmeans)
sub_colors <- c(
"C"  = "white",
"N"  = "red",
"P"  = "blue",
"N:P" = "gray60"
)
row_limits <- list(
c(0, 130),    # fila 1 = iWUE
c(-35, -23),   # fila 2 = δ13C
c(0.5, 1.3)   # fila 3 = Ci
)
row_limits_N <- list(
c(2.8, 3.5),    # fila 1 = iWUE
c(-1, 1),   # fila 2 = δ13C
c(0.8, 4.3),
c(3, 30)
