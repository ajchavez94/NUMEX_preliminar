data_for_R <- read_excel('data_for_R.xlsx')
library(ggpmisc)
library(smatr)
library(lmodel2)
library("kableExtra")
library("openxlsx")
library(readxl)
library(tidyverse)
library(dplyr)
getwd()
data_for_R <- read_excel('data_for_R.xlsx')
data = data_for_R
datos_3000 <- data%>%
filter(data$Site == "CaNu")
datos_1000 <- data%>%
filter(data$Site == "BoN")
datos_2000 <- data %>%
filter(data$Site == "SFNu")
library(ggplot2)
library(ggpmisc)
data$name <- factor(
data$name,
levels = c(
"Clarisia  racemosa",
"Pouteria torta",
"Alchornea lojaensis",
"Myrcia sp nov",
"Hedyosmun  purpurascens",
"Weinmania  loxensis"
)
)
species_colors <- c(
"Pouteria torta" = "orange",
"Clarisia  racemosa" = "gold",
"Alchornea lojaensis" = "green",
"Myrcia sp nov" = "darkgreen",
"Hedyosmun  purpurascens" = "purple",
"Weinmania  loxensis" = "blue"
)
old_theme <- theme_set(theme_bw())
data$Treatment<- with(
data,
ifelse(N == 0 & P == 0, "C",
ifelse(N == 1 & P == 0, "N",
ifelse(N == 0 & P == 1, "P", "N:P")))
)
data$Treatment<- factor(
data$Treatment,
levels = c("C", "N", "P", "N:P")
)
sub_colors <- c(
"C"  = "white",
"N"  = "red",
"P"  = "blue",
"N:P" = "gray60"
)
ggplot(data, aes(N_area, `iWUE (μmol/mol)`)) +
geom_point(aes(fill= Treatment),
shape = 21,
color="black",
size = 1.5) +#aes(shape = SUB), size = 3
stat_ma_line(method = "SMA",color="black",linewidth = 0.5) +
stat_ma_eq(
method = "SMA",
mapping = use_label("eq", "R2"),
size =1.8,
) +
scale_fill_manual(
values = sub_colors)+
facet_wrap(~name,nrow = 1)  +
labs(
x = "Narea",
y = "iWUE (μmol/mol)",
) +
theme(legend.position = "bottom",
strip.text = element_text(
size = 7,
face = "italic")
)
