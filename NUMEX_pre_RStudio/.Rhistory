getwd()
data_for_R <- read_excel('data_for_R.xlsx')
data= data_for_R
### nutrientes para ver cual funciona mejor.
data$logNmass <- log(data$LNC) #
data$logCmass <- log(data$LCC) #
data$logPmass <- log(data$LPC) #
data$SUB = data$Sub #porque abajo esta en mayuscula
#solo dejar las necesarias
data <- dplyr::select(data,
`name`,
`genus`,
`SUB`,#
`N`,
`P`,
`Bloque`,
`elevation_m`,
`iWUE (μmol/mol)`,
`δ18O in ‰ vs DeltaSMOW`,
`Specific leaf area (cm²/g)`,
`δ13C (‰ v.s.V-PDB)`,
`force to punch (kN/m)`,
`thickness (mm)`,`N:P`,
Ci,LNC,LPC,LCC,logNmass,logCmass,logPmass,P_area,N_area,C_area)
#global ANOVA for all the samples
#variables = δ18O in ‰ vs DeltaSMOW`
anova_species_treat <- aov( `iWUE (μmol/mol)`~ name * SUB, data = data) #Uses all dataset. Interaction between species and treatment
summary(anova_species_treat)
# Species order
species_order <- c(
"Pouteria torta",
"Alchornea lojaensis",
"Weinmania loxensis",
"Clarisia racemosa",
"Myrcia sp nov",
"Hedyosmun purpurascens"
)
data$name <- factor(data$name, levels = species_order)
# Elevation map
plot_coefs <- function(model, title, color = "black") {
coefs <- broom.mixed::tidy(
model,
effects = "fixed",
conf.int = TRUE,
conf.level = 0.95
) %>%
dplyr::filter(term != "(Intercept)") %>%
dplyr::mutate(
term = gsub("^Sub", "", term),
sig = dplyr::case_when(
p.value < 0.001 ~ "***",
p.value < 0.01  ~ "**",
p.value < 0.05  ~ "*",
TRUE            ~ ""
)
)
ggplot2::ggplot(coefs, ggplot2::aes(x = term, y = estimate)) +
ggplot2::geom_point(size = 3, color = color) +
ggplot2::geom_errorbar(
ggplot2::aes(ymin = conf.low, ymax = conf.high),
width = 0.15,
color = color
) +
ggplot2::geom_text(
ggplot2::aes(
label = sig,
y = conf.high + 0.05 * max(abs(estimate))
),
vjust = -0.6,
size = 5,
color = color
) +
ggplot2::geom_hline(
yintercept = 0,
linetype = "dashed",
color = "grey40"
) +
ggplot2::labs(
title = title,
x = "",
y = "Estimate (± 95% CI)"
) +
ggplot2::scale_y_continuous(expand = ggplot2::expansion(mult = c(0.05, 0.2))) +
ggplot2::coord_cartesian(clip = "off") +
ggplot2::theme(
axis.text.x = element_text(angle = 45, hjust = 1)
)
}
tabla <- function(model_list) {
tab <- modelsummary(
model_list,
output = "data.frame",
statistics = TRUE,
stars = TRUE,
gof_map = c("nobs", "r2.marginal", "r2.conditional", "aic")
)
# Transponer
tab_t <- as.data.frame(t(tab))
# Usar primera fila como nombres
colnames(tab_t) <- as.character(tab_t[1, ])
# Hacer nombres únicos
colnames(tab_t) <- make.unique(colnames(tab_t))
# Eliminar fila usada como header
tab_t <- tab_t[-1, , drop = FALSE]
# Guardar nombres de modelo
tab_t$Modelo <- rownames(tab_t)
rownames(tab_t) <- NULL
# Reordenar columnas
tab_t <- tab_t[, c("Modelo", setdiff(names(tab_t), "Modelo")), drop = FALSE]
# Exportar a Excel
# 👉 Capturar nombre del objeto
nombre_modelo <- deparse(substitute(model_list))
file_name <- paste0(nombre_modelo, ".xlsx")
write.xlsx(tab_t, file_name, overwrite = TRUE, asTable = TRUE)
message("✔ Model saved on excel")
# Retornar tabla para markdown / PDF / HTML
return(kbl(tab_t, booktabs = TRUE, align = "l"))
}
