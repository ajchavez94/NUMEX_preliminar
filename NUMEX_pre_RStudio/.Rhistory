plot(f, r,
main = paste(name, "- Residuals"),
xlab = "Fitted values",
ylab = "Residuals")
abline(h = 0, col = "red")
# 2. QQ plot
qqnorm(r, main = paste(name, "- QQ plot"))
qqline(r, col = "red")
}
