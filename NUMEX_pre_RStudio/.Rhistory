"C:N"  = anova_model_CN_m
)
modelsummary(
mods_2000,
statistic = "({statistic}, p = {p.value})",
stars = c('*' = .05, '**' = .01, '***' = .001),
fmt = 2,
output = "markdown",
title = "ANOVA results for 2000 species*")
mods_3000 <- list(
"Weinmannia – iWUE" = anova_model_iWUE_Wl,
"Weinmannia – δ18O" = anova_model_18O_Wl,
"Weinmannia – δ15N" = anova_model_15N_Wl,
"Weinmannia – C:N"  = anova_model_CN_Wl,
"Hedyosmum – iWUE"  = anova_model_iWUE_Hp,
"Hedyosmum – δ18O"  = anova_model_18O_Hp,
"Hedyosmum – δ15N"  = anova_model_15N_Hp,
"Hedyosmum – C:N"   = anova_model_CN_Hp
)
modelsummary(
mods_3000,
statistic = "({statistic}, p = {p.value})",
stars = c('*' = .05, '**' = .01, '***' = .001),
fmt = 2,
output = "markdown",
title = "ANOVA results for *3000 species*")
