plots <- lapply(seq_along(models_iWUE), function(i){
emm <- emmeans(models_iWUE[[i]], ~ N*P)
row_id <- ceiling(i/6)
plot(emm, horizontal = FALSE) +
ggtitle(names(models_iWUE)[i]) +
theme_bw()
})
wrap_plots(plots, ncol = 6)
sub_colors <- c(
"C"  = "white",
"N"  = "red",
"P"  = "blue",
"N:P" = "gray60"
)
row_limits <- list(
c(0, 130),    # fila 1 = iWUE
c(-35, -23),   # fila 2 = δ13C
c(0.5, 1.3)   # fila 3 = Ci
)
row_limits_N <- list(
c(2.8, 3.5),    # fila 1 = iWUE
c(-1, 1),   # fila 2 = δ13C
c(0.8, 4.3),
c(3, 30)
)
row_limits_morpho <- list(
c(2.8, 3.5),    # fila 1 = iWUE
c(-1, 1),   # fila 2 = δ13C
c(0.8, 4.3),
c(3, 30),
c(3, 30)
)
#models_iWUE models_N_graphic models_leaf
plots <- lapply(seq_along(models_leaf), function(i){
emm_df <- as.data.frame(
emmeans(models_leaf[[i]], ~ N*P)
)
emm_df$Treatment <- with(
emm_df,
ifelse(N == 0 & P == 0, "C",
ifelse(N == 1 & P == 0, "N",
ifelse(N == 0 & P == 1, "P", "N:P")))
)
emm_df$Treatment <- factor(
emm_df$Treatment,
levels = c("C", "N", "P", "N:P")
)
# valor EMM del control
control_mean <- emm_df$emmean[emm_df$Treatment == "C"]
row_id <- ceiling(i/6)
first_col <- (i - 1) %% 6 == 0
p<- ggplot(
emm_df,
aes(
x = Treatment,
y = emmean,
colour = Treatment
)
) +
geom_linerange(
aes(ymin = lower.CL, ymax = upper.CL),
width = 0.10,
colour = "black"
) +
geom_point(
fill= sub_colors,
shape = 21,
size = 4,
alpha = 0.95,
color = "black"
)+
geom_hline(
yintercept = control_mean,
colour = "gray60",
linetype = "dashed",
linewidth = 0.6
) +
scale_color_manual(values = sub_colors) +
coord_cartesian(
ylim = row_limits_morpho[[row_id]]
) +
labs(
title = names(models_leaf)[i],
x = NULL,
y = NULL
) +
theme_bw(base_size =14) +
theme(
plot.title = element_text(size = 8),
axis.text.x = element_text(angle = 45, hjust = 1))#,
panel.grid.major = element_line(color = "gray60", linewidth = 0.1)#color de la grid
#)
if(!first_col){
p <- p +
theme(
axis.text.y  = element_blank(),
axis.title.y = element_blank()
)
}
p
})
final_plot <- wrap_plots(
plots,
ncol = 6,
nrow = 4, #######
guides = "collect",
) &
theme(base_size = 14,
legend.position = "bottom",
plot.margin = margin(t = 0, r = 0, b = 0, l = 0, unit = "pt")
)
ggsave(
"dummies_mod.png",
final_plot,
width = 12,
height = 10,
dpi = 300
)
