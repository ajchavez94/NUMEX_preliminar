N_SE        = co["N", "Std. Error"],
P_est       = co["P", "Estimate"],
P_SE        = co["P", "Std. Error"],
NP_est      = if ("N:P" %in% rownames(co)) co["N:P", "Estimate"] else NA,
NP_SE       = if ("N:P" %in% rownames(co)) co["N:P", "Std. Error"] else NA,
R2_marginal = unname(r2[1, "R2m"]),
R2_conditional = unname(r2[1, "R2c"]),
AIC         = AIC(m)
)
}
# ------------------------------------------------------------
# 4) Recorrer todas las filas del CSV de comparación
# ------------------------------------------------------------
final_results <- list()
for (i in seq_len(nrow(comparison))) {
sp   <- comparison$species[i]
resp <- comparison$response[i]
best <- comparison$best_model[i]
res <- tryCatch(
extract_best_model(datasets[[sp]], resp, best),
error = function(e) {
message("⚠ Error en ", sp, " - ", resp, ": ", e$message)
NULL
}
)
if (!is.null(res)) {
res$species  <- sp
res$response <- resp
res$model    <- best
final_results[[paste(sp, resp)]] <- res
}
}
final_table <- do.call(rbind, final_results)
rownames(final_table) <- NULL
final_table <- final_table[, c(
"species", "response", "model",
"N_est", "N_SE", "P_est", "P_SE",
"NP_est", "NP_SE",
"R2_marginal", "R2_conditional", "AIC"
)]
print(final_table, digits = 3)
write.csv(final_table, "tabla_resultados_finales.csv", row.names = FALSE)
View(tabla)
View(tabla)
View(tabla)
View(tabla)
tabla <- function(model_list) {
tab <- modelsummary(
model_list,
output    = "data.frame",
estimate  = "{estimate}{stars} (SE = {std.error}, p = {p.value})",  # 👈 aquí va todo junto
statistic = NULL,                                                   # 👈 ya no hace falta línea aparte
stars     = TRUE,                                                   # necesario para que {stars} se resuelva
fmt       = 3,                                                      # opcional: controla decimales
gof_map   = c("nobs", "r2.marginal", "r2.conditional", "aic")
)
# Transponer
tab_t <- as.data.frame(t(tab))
# Usar primera fila como nombres
colnames(tab_t) <- as.character(tab_t[1, ])
# Hacer nombres únicos
colnames(tab_t) <- make.unique(colnames(tab_t))
# Eliminar fila usada como header
tab_t <- tab_t[-1, , drop = FALSE]
# Guardar nombres de modelo
tab_t$Modelo <- rownames(tab_t)
rownames(tab_t) <- NULL
# Reordenar columnas
tab_t <- tab_t[, c("Modelo", setdiff(names(tab_t), "Modelo")), drop = FALSE]
# Exportar a Excel
# 👉 Capturar nombre del objeto
nombre_modelo <- deparse(substitute(model_list))
file_name <- paste0(nombre_modelo, ".xlsx")
write.xlsx(tab_t, file_name, overwrite = TRUE, asTable = TRUE)
message("✔ Model saved on excel")
# Retornar tabla para markdown / PDF / HTML
return(kbl(tab_t, booktabs = TRUE, align = "l"))
}
tabla(models_iWUE)
tabla <- function(model_list) {
tab <- modelsummary(
model_list,
output    = "data.frame",
estimate  = "{estimate}{stars} (SE = {std.error}, p = {p.value})",  # 👈 aquí va todo junto
statistic = NULL,                                                   # 👈 ya no hace falta línea aparte
stars     = TRUE,                                                   # necesario para que {stars} se resuelva
fmt       = 2,                                                      # opcional: controla decimales
gof_map   = c("nobs", "r2.marginal", "r2.conditional", "aic")
)
# Transponer
tab_t <- as.data.frame(t(tab))
# Usar primera fila como nombres
colnames(tab_t) <- as.character(tab_t[1, ])
# Hacer nombres únicos
colnames(tab_t) <- make.unique(colnames(tab_t))
# Eliminar fila usada como header
tab_t <- tab_t[-1, , drop = FALSE]
# Guardar nombres de modelo
tab_t$Modelo <- rownames(tab_t)
rownames(tab_t) <- NULL
# Reordenar columnas
tab_t <- tab_t[, c("Modelo", setdiff(names(tab_t), "Modelo")), drop = FALSE]
# Exportar a Excel
# 👉 Capturar nombre del objeto
nombre_modelo <- deparse(substitute(model_list))
file_name <- paste0(nombre_modelo, ".xlsx")
write.xlsx(tab_t, file_name, overwrite = TRUE, asTable = TRUE)
message("✔ Model saved on excel")
# Retornar tabla para markdown / PDF / HTML
return(kbl(tab_t, booktabs = TRUE, align = "l"))
}
