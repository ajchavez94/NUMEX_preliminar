)
final_plot
library(emmeans)
library(ggplot2)
library(patchwork)
library(ggthemes)
sub_colors <- c(
"C"  = "grey40",
"N"  = "blue",
"P"  = "yellow",
"N:P" = "red"
)
row_limits <- list(
c(10, 130),    # fila 1 = iWUE
c(-33, -23),   # fila 2 = δ13C
c(0.5, 0.95)   # fila 3 = Ci
)
row_limits_N <- list(
c(0, 0.5),    # fila 1 = iWUE
c(-0.50, 0.5),   # fila 2 = δ13C
c(0, 5),
c(10, 30)
)
#models_iWUE
plots <- lapply(seq_along(models_N_graphic), function(i){
emm_df <- as.data.frame(
emmeans(models_N_graphic[[i]], ~ N*P)
)
emm_df$Treatment <- with(
emm_df,
ifelse(N == 0 & P == 0, "C",
ifelse(N == 1 & P == 0, "N",
ifelse(N == 0 & P == 1, "P", "N:P")))
)
emm_df$Treatment <- factor(
emm_df$Treatment,
levels = c("C", "N", "P", "N:P")
)
# valor EMM del control
control_mean <- emm_df$emmean[emm_df$Treatment == "C"]
row_id <- ceiling(i/6)
first_col <- (i - 1) %% 6 == 0
p<- ggplot(
emm_df,
aes(
x = Treatment,
y = emmean,
color=Treatment
)
) +
geom_hline(
yintercept = control_mean,
colour = "gray60",
linetype = "dashed",
linewidth = 0.6
) +
geom_pointrange(
aes(
ymin = lower.CL,
ymax = upper.CL
)
) +
scale_color_manual(values = sub_colors) +
coord_cartesian(
ylim = row_limits_N[[row_id]]
) +
labs(
title = names(models_N_graphic)[i],
x = NULL,
y = NULL
) +
theme_bw(base_size =14) +
theme(
plot.title = element_text(size = 8),
axis.text.x = element_text(angle = 45, hjust = 1))#,
# panel.grid.major = element_line(color = "gray60", linewidth = 0.4)#color de la grid
#)
if(!first_col){
p <- p +
theme(
axis.text.y  = element_blank(),
axis.title.y = element_blank()
)
}
p
})
final_plot <- wrap_plots(
plots,
ncol = 6,
nrow = 4, #######
guides = "collect",
) &
theme(base_size = 14,
legend.position = "bottom",
plot.margin = margin(t = 0, r = 0, b = 0, l = 0, unit = "pt")
)
ggsave(
"dummies_mod.png",
final_plot,
width = 18,
height = 12,
dpi = 300
)
final_plot
