RASGOS_SUPLEMENTO  <- c("N_area", "P_area", "LNC", "LPC")
# grosor y dureza quedan solo en la figura exploratoria (sección 4)
# Tamaños, pensados para A4 (la figura se guarda a tamaño real)
LETRA        <- 9      # tamaño base de letra (puntos)
TAMANO_EQ    <- 2.3    # tamaño de la ecuación (en mm; 2.3 ≈ 6.5 pt). Sube a 2.6 si no se lee
TAMANO_PUNTO <- 1.4
COLORES_TRAT <- c("C" = "white", "P" = "#2c6fbb", "N" = "#c0392b", "N+P" = "#7f7f7f")
# Sombreado del fondo de cada panel según la elevación (mismo que la figura de % de cambio)
COLORES_ELEV <- c("1000" = "#FFD43B",   # amarillo
"2000" = "#9BD18B",   # verde claro
"3000" = "#1B5E20")   # verde oscuro
ALFA_FONDO   <- 0.20   # transparencia del sombreado (0 = invisible, 1 = opaco)
# Escalas de los paneles dentro de cada fila:
#   "free_y" = eje X COMÚN a las 6 especies (se comparan entre elevaciones), Y libre
#   "fixed"  = X e Y comunes
#   "free"   = cada panel con sus propios ejes (versión anterior)
ESCALAS <- "free_y"
# Chunk 3: paquetes
library(readxl)
library(dplyr)
library(tidyr)
library(ggplot2)
library(patchwork)
library(smatr)       # sma()
library(flextable)   # tabla en Word
library(officer)
# Chunk 4: datos
datos <- read_excel(ARCHIVO, sheet = HOJA) %>%
mutate(species_label = trimws(gsub("\\s+", " ", species_label)))  # quita espacios dobles
# Buscar columnas con caracteres especiales (µ, ², ‰) por patrón, sin teclearlas.
# Aborta si el patrón no encuentra exactamente una columna.
col_por_patron <- function(patron) {
hit <- grep(patron, names(datos), value = TRUE)
if (length(hit) != 1) stop("El patrón '", patron, "' encontró ", length(hit),
" columnas: ", paste(hit, collapse = " | "))
hit
}
COL_iWUE <- col_por_patron("^iWUE_Bernacchi")
# Chunk 5: especies
# El orden de las filas es el orden de los paneles (izquierda → derecha)
especies <- data.frame(
nombre_datos = c("Pouteria torta", "Clarisia racemosa", "Alchornea lojaensis",
"Myrcia sp nov", "Hedyosmum purpurascens", "Weinmannia loxensis"),
corto        = c("P. torta", "C. racemosa", "A. lojaensis",
"Myrcia sp. nov.", "H. purpurascens", "W. loxensis"),
elevacion    = c(1000, 1000, 2000, 2000, 3000, 3000)
)
faltan <- setdiff(especies$nombre_datos, unique(datos$species_label))
if (length(faltan) > 0) stop("No encuentro en los datos: ", paste(faltan, collapse = ", "))
# Chunk 6: rasgos
# clave    = nombre corto que se usa en el código
# columna  = columna real del Excel (las raras se buscan por patrón)
# etiqueta = texto del eje x (con unidades)
rasgos <- data.frame(
clave    = c("N_area", "P_area", "LNC", "LPC", "SLA", "Thickness", "Toughness"),
columna  = c("N_area", "P_area", "LNC", "LPC",
col_por_patron("^Specific leaf area"),
col_por_patron("^thickness"),
col_por_patron("^force to punch")),
etiqueta = c("N area (g m⁻²)", "P area (g m⁻²)",
"LNC (mg g⁻¹)", "LPC (mg g⁻¹)",
"SLA (cm² g⁻¹)", "Leaf thickness (mm)",
"Punch force (kN m⁻¹)"),
stringsAsFactors = FALSE
)
rasgos   # revisa que cada patrón encontró la columna correcta
# Chunk 7: datos-largos
# Formato largo: una fila por árbol × rasgo, con su iWUE
largo <- datos %>%
filter(species_label %in% especies$nombre_datos) %>%
mutate(
especie = factor(especies$corto[match(species_label, especies$nombre_datos)],
levels = especies$corto),
Tratamiento = factor(ifelse(N == 0 & P == 0, "C",
ifelse(N == 1 & P == 0, "N",
ifelse(N == 0 & P == 1, "P", "N+P"))),
levels = c("C", "N", "P", "N+P")),
iWUE = .data[[COL_iWUE]]
) %>%
# quedarse con lo necesario y renombrar cada rasgo con su clave corta
select(especie, Tratamiento, iWUE, all_of(setNames(rasgos$columna, rasgos$clave))) %>%
pivot_longer(cols = all_of(rasgos$clave), names_to = "rasgo", values_to = "x") %>%
filter(!is.na(x), !is.na(iWUE))
count(largo, rasgo, especie) %>% pivot_wider(names_from = especie, values_from = n)
# Chunk 8: ajuste-sma
# Formato de números: 3 cifras significativas (sirve igual para pendientes de 0.5 o de 300)
f3 <- function(v) formatC(signif(v, 3), format = "fg", digits = 3)
fp <- function(p) ifelse(p < 0.001, "< 0.001", paste("=", sprintf("%.3f", p)))
tabla_sma <- data.frame()
for (r in rasgos$clave) {
for (sp in especies$corto) {
d <- filter(largo, rasgo == r, especie == sp)
ajuste <- sma(iWUE ~ x, data = d)          # SMA, iWUE en y
co <- ajuste$coef[[1]]                       # filas: elevation (intercepto), slope
tabla_sma <- rbind(tabla_sma, data.frame(
rasgo      = r,
especie    = sp,
elevacion  = especies$elevacion[especies$corto == sp],
n          = nrow(d),
pendiente  = co[2, 1], pend_inf = co[2, 2], pend_sup = co[2, 3],
intercepto = co[1, 1],
R2         = ajuste$r2[[1]],
p          = ajuste$pval[[1]],   # test de correlación (pendiente ≠ 0)
x_min = min(d$x), x_max = max(d$x)
))
}
}
# p corregido por Benjamini-Hochberg sobre las 42 pruebas
tabla_sma$p_BH <- p.adjust(tabla_sma$p, method = "BH")
# Texto de la ecuación de cada panel
tabla_sma$ecuacion <- with(tabla_sma, paste0(
"y = ", f3(intercepto), ifelse(pendiente < 0, " − ", " + "), f3(abs(pendiente)), "x\n",
"R² = ", sprintf("%.2f", R2), ", p ", fp(p)))
# Chunk 9: funcion-figura
# Dibuja UNA fila: un rasgo × 6 especies
fila_sma <- function(clave_rasgo, con_titulos = TRUE) {
# Título de cada panel en dos líneas: especie en cursiva y elevación debajo.
# Se escribe como una expresión de R (plotmath) que label_parsed convierte en texto.
titulos <- paste0("atop(italic('", especies$corto, "'), '", especies$elevacion, " m')")
titulo_de <- function(sp) factor(titulos[match(sp, especies$corto)], levels = titulos)
d <- filter(largo, rasgo == clave_rasgo) %>%
mutate(panel = titulo_de(as.character(especie)))
# Un rectángulo de fondo por especie, del color de su elevación
fondos <- especies %>%
mutate(panel = titulo_de(corto),
color = COLORES_ELEV[as.character(elevacion)])
t <- filter(tabla_sma, rasgo == clave_rasgo) %>%
mutate(panel = titulo_de(especie),
# extremos de la línea, solo dentro del rango de los datos
y_ini = intercepto + pendiente * x_min,
y_fin = intercepto + pendiente * x_max,
significativo = ifelse(p < 0.05, "p < 0.05", "n.s."),
# ecuación en la esquina libre
x_eq  = ifelse(pendiente < 0, Inf, -Inf),
h_eq  = ifelse(pendiente < 0, 1.03, -0.03))
ggplot(d, aes(x = x, y = iWUE)) +
# sombreado por elevación: va primero para quedar detrás de todo.
# El color se da fuera de aes() para no chocar con el relleno de los tratamientos.
geom_rect(data = fondos,
aes(xmin = -Inf, xmax = Inf, ymin = -Inf, ymax = Inf),
fill = fondos$color, alpha = ALFA_FONDO, inherit.aes = FALSE) +
geom_point(aes(fill = Tratamiento), shape = 21, colour = "black",
size = TAMANO_PUNTO, stroke = 0.25) +
geom_segment(data = t,
aes(x = x_min, xend = x_max, y = y_ini, yend = y_fin,
linetype = significativo),
inherit.aes = FALSE, linewidth = 0.6) +
geom_text(data = t, aes(x = x_eq, y = Inf, label = ecuacion, hjust = h_eq),
vjust = 1.15, size = TAMANO_EQ, lineheight = 0.9, inherit.aes = FALSE) +
facet_wrap(~ panel, nrow = 1, scales = ESCALAS, labeller = label_parsed) +
scale_fill_manual(values = COLORES_TRAT, name = "Treatment", drop = FALSE) +
scale_linetype_manual(values = c("p < 0.05" = "solid", "n.s." = "dashed"),
name = "SMA", drop = FALSE) +
scale_y_continuous(expand = expansion(mult = c(0.05, 0.32))) +  # aire arriba para la ecuación
labs(x = rasgos$etiqueta[rasgos$clave == clave_rasgo],
y = "iWUE (µmol mol⁻¹)") +
theme_classic(base_size = LETRA) +
theme(strip.background = element_blank(),
strip.text = element_text(size = LETRA),   # la cursiva ya va en el título
strip.text.x = if (con_titulos) element_text(size = LETRA) else element_blank(),
axis.text  = element_text(colour = "black", size = LETRA - 2),
legend.position = "bottom")
}
# Junta varias filas en una figura con una sola leyenda
figura_sma <- function(claves) {
filas <- lapply(seq_along(claves), function(i) fila_sma(claves[i], con_titulos = TRUE))
wrap_plots(filas, ncol = 1) +
plot_layout(guides = "collect") &
theme(legend.position = "bottom")
}
# Chunk 10: figura-completa
fig_todas <- figura_sma(rasgos$clave)
ggsave("SMA_iWUE_Bernacchi_all_traits.png", fig_todas,
width = 190, height = 330, units = "mm", dpi = 300)
fig_todas
# Chunk 11: tabla-p
tabla_ver <- tabla_sma %>%
transmute(Rasgo = rasgo, Especie = especie, Elevación = elevacion, n,
Pendiente = f3(pendiente),
`IC 95 %` = paste0("[", f3(pend_inf), ", ", f3(pend_sup), "]"),
Intercepto = f3(intercepto),
R2 = round(R2, 2),
p = signif(p, 3),
`p (BH)` = signif(p_BH, 3),
Sig = ifelse(p < 0.05, "*", ""))
write.csv(tabla_sma, "SMA_iWUE_Bernacchi_table.csv", row.names = FALSE)
knitr::kable(tabla_ver)
# Chunk 12: resumen-por-rasgo
# ¿En cuántas especies es significativa cada relación, y con qué signo?
tabla_sma %>%
group_by(rasgo) %>%
summarise(especies_p05   = sum(p < 0.05),
especies_pBH05 = sum(p_BH < 0.05),
negativas      = sum(pendiente < 0 & p < 0.05),
positivas      = sum(pendiente > 0 & p < 0.05),
R2_rango       = paste0(sprintf("%.2f", min(R2)), "–", sprintf("%.2f", max(R2))))
# Chunk 13: comprobacion-area
COL_SLA <- rasgos$columna[rasgos$clave == "SLA"]
c(max_dif_Narea = max(abs(datos$N_area - 10 * datos$LNC / datos[[COL_SLA]]), na.rm = TRUE),
max_dif_Parea = max(abs(datos$P_area - 10 * datos$LPC / datos[[COL_SLA]]), na.rm = TRUE))
# Chunk 14: fig-principal
fig_principal <- figura_sma(RASGOS_PRINCIPAL)
ggsave("fig_MAIN_SMA_iWUE_SLA_Bernacchi.png", fig_principal,
width = 180, height = 70, units = "mm", dpi = 300)
fig_principal
# Chunk 15: fig-suplemento
fig_suplemento <- figura_sma(RASGOS_SUPLEMENTO)
ggsave("fig_SUPP_SMA_iWUE_nutrients_Bernacchi.png", fig_suplemento,
width = 180, height = 50 * length(RASGOS_SUPLEMENTO), units = "mm", dpi = 300)
fig_suplemento
# Chunk 16: tabla-word
rasgos_ms <- c(RASGOS_PRINCIPAL, RASGOS_SUPLEMENTO)
tabla_ms <- tabla_sma %>%
filter(rasgo %in% rasgos_ms) %>%
mutate(rasgo = factor(rasgo, levels = rasgos_ms),
especie = factor(especie, levels = especies$corto)) %>%
arrange(rasgo, especie) %>%
transmute(Trait = rasgos$etiqueta[match(as.character(rasgo), rasgos$clave)],
Species = as.character(especie),
n,
`Slope [95% CI]` = paste0(f3(pendiente), " [", f3(pend_inf), ", ", f3(pend_sup), "]"),
Intercept = f3(intercepto),
`R²` = sprintf("%.2f", R2),
p = ifelse(p < 0.001, "< 0.001", sprintf("%.3f", p)))
ft <- flextable(tabla_ms) %>%
theme_booktabs() %>%
merge_v(j = "Trait") %>%
valign(j = "Trait", valign = "top", part = "body") %>%
italic(j = "Species", part = "body") %>%
bold(part = "header") %>%
hline(i = seq(6, nrow(tabla_ms) - 1, by = 6), border = fp_border(color = "grey60", width = 0.5)) %>%
add_footer_lines(paste(
"Standardized major axis (SMA) regressions of iWUE (Bernacchi) on each trait within",
"species. p tests whether the slope differs from zero (correlation test).",
"N area = 10 × LNC / SLA and P area = 10 × LPC / SLA.")) %>%
font(fontname = "Times New Roman", part = "all") %>%
fontsize(size = 9, part = "all") %>%
fontsize(size = 8, part = "footer") %>%
autofit()
save_as_docx(ft, path = "Table_SMA_iWUE_Bernacchi.docx")
ft
# Chunk 17: frase-resultados
frase_rasgo <- function(r, nombre) {
t <- filter(tabla_sma, rasgo == r)
sig <- filter(t, p < 0.05)
signo <- if (nrow(sig) > 0 && all(sig$pendiente < 0)) "negatively" else
if (nrow(sig) > 0 && all(sig$pendiente > 0)) "positively" else "significantly"
if (nrow(sig) == 0) return(paste0("iWUE was not related to ", nombre, " in any species."))
paste0("iWUE was ", signo, " related to ", nombre, " in ", nrow(sig), " of 6 species ",
"(R² = ", sprintf("%.2f", min(sig$R2)), "–", sprintf("%.2f", max(sig$R2)), ")")
}
cat(paste0(
"Within species, ", frase_rasgo("SLA", "SLA"), ". ",
"Relationships with N area (", sum(tabla_sma$rasgo == "N_area" & tabla_sma$p < 0.05),
" of 6 species) and P area (", sum(tabla_sma$rasgo == "P_area" & tabla_sma$p < 0.05),
" of 6) are not independent of SLA, since both are calculated from it, whereas iWUE was ",
"related to mass-based LNC in ", sum(tabla_sma$rasgo == "LNC" & tabla_sma$p < 0.05),
" and to LPC in ", sum(tabla_sma$rasgo == "LPC" & tabla_sma$p < 0.05),
" of 6 species (Table S_, Figure S_)."))
