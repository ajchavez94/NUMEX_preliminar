cambio_pct %>%
filter(variable == "log LPC (mg g-1)", Treatment == "P") %>%
transmute(especie, n_obs,
`cambio %` = round(pct, 1),
`IC 95%` = sprintf("[%.1f, %.1f]", pct_low, pct_high),
sig) %>%
as.data.frame()
fig_principal <- construir_figura(MODO_MANUSCRITO, VARS_PRINCIPAL)
fig_suplemento <- construir_figura(MODO_MANUSCRITO, VARS_SUPLEMENTO)
# El alto se escala con el número de filas para que los paneles queden cuadrados
alto_por_fila <- ALTO / length(vars_fig)
ggsave("fig_MAIN_emmeans_Bernacchi_EN.png", fig_principal,
width = ANCHO, height = alto_por_fila * length(VARS_PRINCIPAL) + 1, dpi = 300)
ggsave("fig_SUPP_emmeans_Bernacchi_EN.png", fig_suplemento,
width = ANCHO, height = alto_por_fila * length(VARS_SUPLEMENTO) + 1, dpi = 300)
message("Guardadas las figuras del manuscrito.")
fig_principal
# La misma información en números, redondeada, para el texto o el suplementario.
cambio_pct %>%
filter(variable == "log LPC (mg g-1)", Treatment == "P") %>%
transmute(especie, n_obs,
`cambio %` = round(pct, 1),
`IC 95%` = sprintf("[%.1f, %.1f]", pct_low, pct_high),
sig) %>%
as.data.frame()
# ---- Ajustes editables -----------------------------------------------------
# ln del cociente N:P
COLUMNAS_LOG <- c("logNmass", "logPmass", "logNP")
# Título de cada panel (izquierda → derecha), según el nombre de la columna
TITULOS <- c(logNmass = "Leaf N (mass-based)",
logPmass = "Leaf P (mass-based)",
logNP    = "Leaf N:P ratio")
# Elevación de cada especie (para el sombreado)
ELEVACION <- c("P. torta" = "1000 m", "C. racemosa" = "1000 m",
"A. lojaensis" = "2000 m", "Myrcia sp. nov." = "2000 m",
"H. purpurascens" = "3000 m", "W. loxensis" = "3000 m")
COLORES_ELEV <- c("1000 m" = "#FFD43B",   # amarillo
"2000 m" = "#9BD18B",   # verde claro
"3000 m" = "#1B5E20")   # verde oscuro
ALFA_SOMBRA  <- 0.25    # transparencia del sombreado (0 a 1)
TAMANO_LETRA <- 10      # puntos, a tamaño real de impresión
ANCHO_MM     <- 180     # ancho útil de una página A4
ALTO_MM      <- 95
# ---- Cálculo del % de cambio -----------------------------------------------
cambio_pct <- map_dfr(resultados, function(r) {
if (!(r$columna %in% COLUMNAS_LOG)) return(NULL)
r$rej %>%
filter(Treatment != "C") %>%
transmute(
variable  = r$variable,
panel     = TITULOS[r$columna],
especie   = r$especie,
Treatment = Treatment,
#n_obs     = n_obs,
# exp() deshace el log y convierte la diferencia en un cociente
pct       = (exp(diff_vs_C)  - 1) * 100,
pct_low   = (exp(diff_low)   - 1) * 100,
pct_high  = (exp(diff_high)  - 1) * 100,
sig       = estrellas(p_none)
)
}) %>%
mutate(
# el PRIMER nivel queda ABAJO del eje Y: P. torta (1000 m) abajo,
# W. loxensis (3000 m) arriba
especie   = factor(especie, levels = names(species_list)),
Treatment = factor(Treatment, levels = c("N", "P", "N+P")),
panel     = factor(panel, levels = TITULOS)   # orden de los paneles
)
write.csv(cambio_pct, "percent_change_vs_control_Bernacchi_EN.csv", row.names = FALSE)
# ---- Bandas de sombreado ---------------------------------------------------
# En un eje de categorías, cada especie ocupa la posición 1, 2, 3...
# Cada banda cubre 2 especies: de 0.5 a 2.5, de 2.5 a 4.5 y de 4.5 a 6.5.
bandas <- data.frame(
elevacion = c("1000 m", "2000 m", "3000 m"),
ymin      = c(0.5, 2.5, 4.5),
ymax      = c(2.5, 4.5, 6.5)
)
separacion <- position_dodge(width = 0.65)   # separa N, P y N+P dentro de cada especie
# ---- Figura ----------------------------------------------------------------
fig_pct <- ggplot(cambio_pct,
aes(x = pct, y = especie, colour = Treatment, shape = Treatment)) +
# sombreado por elevación (va primero para quedar detrás de todo)
geom_rect(data = bandas,
aes(xmin = -Inf, xmax = Inf, ymin = ymin, ymax = ymax, fill = elevacion),
inherit.aes = FALSE, alpha = ALFA_SOMBRA) +
geom_vline(xintercept = 0, colour = "black", linewidth = 0.5) +
geom_errorbarh(aes(xmin = pct_low, xmax = pct_high), height = 0.18,
position = separacion, linewidth = 0.6) +
geom_point(size = 2.4, position = separacion) +
geom_text(aes(label = sig, x = pct_high), hjust = -0.35, vjust = 0.5,
size = 3.2, fontface = "bold", colour = "black", show.legend = FALSE,
position = separacion) +
# aviso de celdas con menos de 3 árboles (p. ej. C. racemosa / N, n = 1)
#geom_text(data = subset(cambio_pct, n_obs < 3),
#          aes(label = paste0("n=", n_obs), x = pct_low), hjust = 1.2, vjust = 0.5,
#          size = 2.3, colour = "black", show.legend = FALSE,
#          position = separacion) +
# scale_y_discrete explícita: necesaria para poder dibujar las bandas
# con números (0.5, 2.5...) sobre un eje de nombres de especie
scale_y_discrete(limits = names(species_list)) +
scale_colour_manual(values = c("N" = C_N, "P" = C_P, "N+P" = C_NP)) +
scale_shape_manual(values = c("N" = 16, "P" = 15, "N+P" = 17)) +
scale_fill_manual(values = COLORES_ELEV, name = "Elevation") +
scale_x_continuous(expand = expansion(mult = c(0.08, 0.16))) +
facet_wrap(~ panel, nrow = 1, scales = "free_x") +      # 1 fila × 3 paneles
labs(x = "Change relative to control (%, ± 95% CI)",
y = NULL, colour = "Treatment", shape = "Treatment") +
theme_bw(base_size = TAMANO_LETRA) +
theme(axis.text.y  = element_text(face = "italic", colour = "black"),
axis.text.x  = element_text(angle = 45, hjust = 1, vjust = 1, colour = "black"),
strip.text   = element_text(face = "bold", size = TAMANO_LETRA),
strip.background = element_blank(),
panel.grid.major.y = element_blank(),
panel.grid.minor   = element_blank(),
legend.position = "bottom")
# Se guarda a tamaño real, así que la letra se verá impresa a TAMANO_LETRA puntos
ggsave("fig_percent_change_Bernacchi_EN.png", fig_pct,
width = ANCHO_MM, height = ALTO_MM, units = "mm", dpi = 300)
fig_pct
# ---- Ajustes editables -----------------------------------------------------
ARCHIVO_iWUE    <- "fig_iWUE_emmeans_Bernacchi_EN.png"
ANCHO_iWUE_MM   <- 180    # ancho útil de una página A4
ALTO_iWUE_MM    <- 100     # 1 fila de 6 paneles cuadrados
LETRA_iWUE      <- 9      # tamaño base de letra, en puntos, a tamaño real
ALFA_FONDO      <- 0.20   # transparencia del fondo por elevación (0 a 1)
# ---- Función ---------------------------------------------------------------
# Igual que construir_figura(), pero para una sola fila (iWUE).
# Cambia dos cosas: el tema pasa a theme_classic() y el fondo de cada panel
# se colorea según la elevación de la especie.
construir_figura_iWUE <- function(modo) {
set.seed(7)   # el jitter de los puntos usa azar; así la figura sale siempre igual
# Etiqueta de iWUE buscada por su columna (no se teclea, por la µ)
etiqueta <- names(vars_fig)[vars_fig == COL_iWUE]
# --- Límites verticales comunes a las 6 especies (mismo cálculo que en
#     construir_figura) -----------------------------------------------------
de_esta_fila <- Filter(function(r) r$variable == etiqueta, resultados)
y_valores <- c(
unlist(lapply(de_esta_fila, function(r) r$crudos$y)),
unlist(lapply(de_esta_fila, function(r) r$rej$lower.CL)),
unlist(lapply(de_esta_fila, function(r) r$rej$upper.CL))
)
y_min <- min(y_valores, na.rm = TRUE)
y_max <- max(y_valores, na.rm = TRUE)
rango <- y_max - y_min
limites <- list(
ylo     = y_min - 0.10 * rango,   # franja de abajo para las etiquetas "n="
yhi     = y_max + 0.14 * rango,   # aire arriba para asteriscos y "N×P"
y_datos = y_min,
y_n     = y_min - 0.055 * rango
)
# --- Un panel por especie ---------------------------------------------------
paneles <- list()
for (j in seq_along(species_data)) {
sp <- names(species_data)[j]
r  <- resultados[[paste(etiqueta, sp, sep = " || ")]]
if (is.null(r)) next
# Color de fondo según la elevación de esta especie
color_fondo <- alpha(COLORES_ELEV[[ELEVACION[[sp]]]], ALFA_FONDO)
TAMANO_MEDIA_iWUE <- 2.0   # tamaño del punto de la media (antes 3.4). Prueba 1.8–2.5
GROSOR_IC_iWUE    <- 0.6   # grosor de la línea del IC (antes 0.5)
# 1) El panel de siempre (puntos, IC, asteriscos, n=, N×P)
p <- panel(
rej         = asteriscos_de(r$rej, modo),
crudos      = r$crudos,
limites     = limites,
etiqueta_y  = if (j == 1) etiqueta else NULL,
titulo      = sp,
con_eje_y   = (j == 1),
interaccion = identical(r$modelo, "N * P"),
tamano_media = TAMANO_MEDIA_iWUE,
grosor_ic    = GROSOR_IC_iWUE
)
# 2) Se reemplaza el tema por uno clásico. theme_classic() borra los ajustes
#    anteriores, por eso se vuelven a poner aquí (cuadrado, título, etc.).
p <- p +
labs(subtitle = ELEVACION[[sp]]) +            # "1000 m" bajo el nombre
theme_classic(base_size = LETRA_iWUE) +
theme(
aspect.ratio     = 1,
plot.title       = element_text(size = LETRA_iWUE, face = "italic", hjust = 0.5),
plot.subtitle    = element_text(size = LETRA_iWUE - 1, hjust = 0.5, colour = "grey30"),
axis.text.x      = element_text(colour = "black"),
axis.text.y      = if (j == 1) element_text(colour = "black") else element_blank(),
axis.title.y     = element_text(size = LETRA_iWUE),
legend.position  = "none",
# el fondo del panel queda DETRÁS de los datos, así no tapa nada
panel.background = element_rect(fill = color_fondo, colour = NA)
)
paneles[[length(paneles) + 1]] <- p
}
wrap_plots(paneles, nrow = 1)   # 1 fila × 6 especies
}
# ---- Construir y guardar ---------------------------------------------------
fig_iWUE <- construir_figura_iWUE(MODO_MANUSCRITO)   # "none" = p sin ajustar
ggsave(ARCHIVO_iWUE, fig_iWUE,
width = ANCHO_iWUE_MM, height = ALTO_iWUE_MM, units = "mm", dpi = 300)
fig_iWUE
