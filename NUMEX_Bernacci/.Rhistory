setwd("C:/Users/Andrea/Downloads/NUMEX_preliminar/NUMEX_Bernacci")
ARCHIVO <- "data_for_R_Bernacchi.xlsx"
HOJA    <- "data"
# ¿Qué rasgos van en cada figura del manuscrito? (claves de la tabla `rasgos`, sección 3)
RASGOS_PRINCIPAL   <- c("SLA")
RASGOS_SUPLEMENTO  <- c("N_area", "P_area", "LNC", "LPC")
# grosor y dureza quedan solo en la figura exploratoria (sección 4)
# Tamaños, pensados para A4 (la figura se guarda a tamaño real)
LETRA        <- 9      # tamaño base de letra (puntos)
TAMANO_EQ    <- 2.3    # tamaño de la ecuación (en mm; 2.3 ≈ 6.5 pt). Sube a 2.6 si no se lee
TAMANO_PUNTO <- 1.4
COLORES_TRAT <- c("C" = "white", "P" = "#2c6fbb", "N" = "#c0392b", "N+P" = "#7f7f7f")
library(readxl)
library(dplyr)
library(tidyr)
library(ggplot2)
library(patchwork)
library(smatr)       # sma()
library(flextable)   # tabla en Word
library(officer)
datos <- read_excel(ARCHIVO, sheet = HOJA) %>%
mutate(species_label = trimws(gsub("\\s+", " ", species_label)))  # quita espacios dobles
# Buscar columnas con caracteres especiales (µ, ², ‰) por patrón, sin teclearlas.
# Aborta si el patrón no encuentra exactamente una columna.
col_por_patron <- function(patron) {
hit <- grep(patron, names(datos), value = TRUE)
if (length(hit) != 1) stop("El patrón '", patron, "' encontró ", length(hit),
" columnas: ", paste(hit, collapse = " | "))
hit
}
COL_iWUE <- col_por_patron("^iWUE_Bernacchi")
# El orden de las filas es el orden de los paneles (izquierda → derecha)
especies <- data.frame(
nombre_datos = c("Pouteria torta", "Clarisia racemosa", "Alchornea lojaensis",
"Myrcia sp nov", "Hedyosmum purpurascens", "Weinmannia loxensis"),
corto        = c("P. torta", "C. racemosa", "A. lojaensis",
"Myrcia sp. nov.", "H. purpurascens", "W. loxensis"),
elevacion    = c(1000, 1000, 2000, 2000, 3000, 3000)
)
faltan <- setdiff(especies$nombre_datos, unique(datos$species_label))
if (length(faltan) > 0) stop("No encuentro en los datos: ", paste(faltan, collapse = ", "))
# El orden de las filas es el orden de los paneles (izquierda → derecha)
especies <- data.frame(
nombre_datos = c("Pouteria torta", "Clarisia racemosa", "Alchornea lojaensis",
"Myrcia sp nov", "Hedyosmum purpurascens", "Weinmannia loxensis"),
corto        = c("P. torta", "C. racemosa", "A. lojaensis",
"Myrcia sp. nov.", "H. purpurascens", "W. loxensis"),
elevacion    = c(1000, 1000, 2000, 2000, 3000, 3000)
)
faltan <- setdiff(especies$nombre_datos, unique(datos$species_label))
if (length(faltan) > 0) stop("No encuentro en los datos: ", paste(faltan, collapse = ", "))
# clave    = nombre corto que se usa en el código
# columna  = columna real del Excel (las raras se buscan por patrón)
# etiqueta = texto del eje x (con unidades)
rasgos <- data.frame(
clave    = c("N_area", "P_area", "LNC", "LPC", "SLA", "Thickness", "Toughness"),
columna  = c("N_area", "P_area", "LNC", "LPC",
col_por_patron("^Specific leaf area"),
col_por_patron("^thickness"),
col_por_patron("^force to punch")),
etiqueta = c("N area (g m⁻²)", "P area (g m⁻²)",
"LNC (mg g⁻¹)", "LPC (mg g⁻¹)",
"SLA (cm² g⁻¹)", "Leaf thickness (mm)",
"Punch force (kN m⁻¹)"),
stringsAsFactors = FALSE
)
rasgos   # revisa que cada patrón encontró la columna correcta
# Formato largo: una fila por árbol × rasgo, con su iWUE
largo <- datos %>%
filter(species_label %in% especies$nombre_datos) %>%
mutate(
especie = factor(especies$corto[match(species_label, especies$nombre_datos)],
levels = especies$corto),
Tratamiento = factor(ifelse(N == 0 & P == 0, "C",
ifelse(N == 1 & P == 0, "N",
ifelse(N == 0 & P == 1, "P", "N+P"))),
levels = c("C", "N", "P", "N+P")),
iWUE = .data[[COL_iWUE]]
) %>%
# quedarse con lo necesario y renombrar cada rasgo con su clave corta
select(especie, Tratamiento, iWUE, all_of(setNames(rasgos$columna, rasgos$clave))) %>%
pivot_longer(cols = all_of(rasgos$clave), names_to = "rasgo", values_to = "x") %>%
filter(!is.na(x), !is.na(iWUE))
count(largo, rasgo, especie) %>% pivot_wider(names_from = especie, values_from = n)
# Formato de números: 3 cifras significativas (sirve igual para pendientes de 0.5 o de 300)
f3 <- function(v) formatC(signif(v, 3), format = "fg", digits = 3)
fp <- function(p) ifelse(p < 0.001, "< 0.001", paste("=", sprintf("%.3f", p)))
tabla_sma <- data.frame()
for (r in rasgos$clave) {
for (sp in especies$corto) {
d <- filter(largo, rasgo == r, especie == sp)
ajuste <- sma(iWUE ~ x, data = d)          # SMA, iWUE en y
co <- ajuste$coef[[1]]                       # filas: elevation (intercepto), slope
tabla_sma <- rbind(tabla_sma, data.frame(
rasgo      = r,
especie    = sp,
elevacion  = especies$elevacion[especies$corto == sp],
n          = nrow(d),
pendiente  = co[2, 1], pend_inf = co[2, 2], pend_sup = co[2, 3],
intercepto = co[1, 1],
R2         = ajuste$r2[[1]],
p          = ajuste$pval[[1]],   # test de correlación (pendiente ≠ 0)
x_min = min(d$x), x_max = max(d$x)
))
}
}
# p corregido por Benjamini-Hochberg sobre las 42 pruebas
tabla_sma$p_BH <- p.adjust(tabla_sma$p, method = "BH")
# Texto de la ecuación de cada panel
tabla_sma$ecuacion <- with(tabla_sma, paste0(
"y = ", f3(intercepto), ifelse(pendiente < 0, " − ", " + "), f3(abs(pendiente)), "x\n",
"R² = ", sprintf("%.2f", R2), ", p ", fp(p)))
# Dibuja UNA fila: un rasgo × 6 especies
fila_sma <- function(clave_rasgo, con_titulos = TRUE) {
d <- filter(largo, rasgo == clave_rasgo)
t <- filter(tabla_sma, rasgo == clave_rasgo) %>%
mutate(especie = factor(especie, levels = especies$corto),
# extremos de la línea, solo dentro del rango de los datos
y_ini = intercepto + pendiente * x_min,
y_fin = intercepto + pendiente * x_max,
significativo = ifelse(p < 0.05, "p < 0.05", "n.s."),
# ecuación en la esquina libre
x_eq  = ifelse(pendiente < 0, Inf, -Inf),
h_eq  = ifelse(pendiente < 0, 1.03, -0.03))
ggplot(d, aes(x = x, y = iWUE)) +
geom_point(aes(fill = Tratamiento), shape = 21, colour = "black",
size = TAMANO_PUNTO, stroke = 0.25) +
geom_segment(data = t,
aes(x = x_min, xend = x_max, y = y_ini, yend = y_fin,
linetype = significativo),
inherit.aes = FALSE, linewidth = 0.6) +
geom_text(data = t, aes(x = x_eq, y = Inf, label = ecuacion, hjust = h_eq),
vjust = 1.15, size = TAMANO_EQ, lineheight = 0.9, inherit.aes = FALSE) +
facet_wrap(~ especie, nrow = 1, scales = "free") +
scale_fill_manual(values = COLORES_TRAT, name = "Treatment", drop = FALSE) +
scale_linetype_manual(values = c("p < 0.05" = "solid", "n.s." = "dashed"),
name = "SMA", drop = FALSE) +
scale_y_continuous(expand = expansion(mult = c(0.05, 0.32))) +  # aire arriba para la ecuación
labs(x = rasgos$etiqueta[rasgos$clave == clave_rasgo],
y = "iWUE (µmol mol⁻¹)") +
theme_classic(base_size = LETRA) +
theme(strip.background = element_blank(),
strip.text = element_text(face = "italic", size = LETRA),
strip.text.x = if (con_titulos) element_text(face = "italic") else element_blank(),
axis.text  = element_text(colour = "black", size = LETRA - 2),
legend.position = "bottom")
}
# Junta varias filas en una figura con una sola leyenda
figura_sma <- function(claves) {
filas <- lapply(seq_along(claves), function(i) fila_sma(claves[i], con_titulos = TRUE))
wrap_plots(filas, ncol = 1) +
plot_layout(guides = "collect") &
theme(legend.position = "bottom")
}
fig_todas <- figura_sma(rasgos$clave)
ggsave("SMA_iWUE_Bernacchi_all_traits.png", fig_todas,
width = 190, height = 330, units = "mm", dpi = 300)
fig_todas
