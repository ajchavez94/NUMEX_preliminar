knitr::opts_chunk$set(echo = TRUE, warning = TRUE, message = FALSE)
# install.packages(c("readxl","dplyr","tidyr","lme4","lmerTest","MuMIn"))
library(readxl)
library(dplyr)
library(tidyr)
library(lme4)
library(lmerTest)
library(MuMIn)
options(na.action = "na.fail")  # required by MuMIn::dredge()
raw <- read_excel("data_for_R.xlsx")
raw <- read_excel("data_for_R.xlsx")
dat <- raw %>%
rename(
iWUE = `iWUE (μmol/mol)`,
d13C = `δ13C (‰ v.s.V-PDB)`
) %>%
mutate(
Bloque = factor(Bloque),
N = factor(N),
P = factor(P),
specie = as.character(specie)
)
remove.packages("withr")
install.packages("withr")
library(withr)
raw <- read_excel("data_for_R.xlsx")
dat <- raw %>%
rename(
iWUE = `iWUE (μmol/mol)`,
d13C = `δ13C (‰ v.s.V-PDB)`
) %>%
mutate(
Bloque = factor(Bloque),
N = factor(N),
P = factor(P),
specie = as.character(specie)
)
species_list <- unique(dat$specie)
variables <- c("iWUE", "d13C")
fit_candidate_set <- function(d, response) {
f_null <- as.formula(paste0(response, " ~ 1 + (1 | Bloque)"))
f_N    <- as.formula(paste0(response, " ~ N + (1 | Bloque)"))
f_P    <- as.formula(paste0(response, " ~ P + (1 | Bloque)"))
f_add  <- as.formula(paste0(response, " ~ N + P + (1 | Bloque)"))
f_int  <- as.formula(paste0(response, " ~ N * P + (1 | Bloque)"))
fits <- list(
null        = lmer(f_null, data = d, REML = FALSE),
N_only      = lmer(f_N,    data = d, REML = FALSE),
P_only      = lmer(f_P,    data = d, REML = FALSE),
additive    = lmer(f_add,  data = d, REML = FALSE),
interactive = lmer(f_int,  data = d, REML = FALSE)
)
sel <- model.sel(fits, rank = "AICc")
sel
}
selection_tables <- list()
for (sp in species_list) {
for (v in variables) {
d_sp <- dat %>% filter(specie == sp)
cat("\n---", sp, "|", v, "---\n")
sel <- tryCatch(
fit_candidate_set(d_sp, v),
error = function(e) { cat("failed:", conditionMessage(e), "\n"); NULL }
)
if (!is.null(sel)) {
print(sel)
tab <- as.data.frame(sel) %>%
mutate(
species = sp,
variable = v,
model = rownames(sel)
)
selection_tables[[paste(sp, v)]] <- tab
}
}
}
all_selection <- bind_rows(selection_tables)
write.csv(all_selection, "AICc_selection_iWUE_d13C.csv", row.names = FALSE)
knitr::opts_chunk$set(echo = TRUE, warning = TRUE, message = FALSE)
# install.packages(c("readxl","dplyr","tidyr","lme4","lmerTest","MuMIn"))
library(readxl)
library(dplyr)
library(tidyr)
library(lme4)
library(lmerTest)
library(MuMIn)
options(na.action = "na.fail")  # required by MuMIn::dredge()
#remove.packages("withr")
#install.packages("withr")
library(withr)
raw <- read_excel("data_for_R.xlsx")
dat <- raw %>%
rename(
iWUE = `iWUE (μmol/mol)`,
d13C = `δ13C (‰ v.s.V-PDB)`
) %>%
mutate(
Bloque = factor(Bloque),
N = factor(N),
P = factor(P),
specie = as.character(specie)
)
species_list <- unique(dat$specie)
variables <- c("iWUE", "d13C")
fit_candidate_set <- function(d, response) {
f_null <- as.formula(paste0(response, " ~ 1 + (1 | Bloque)"))
f_N    <- as.formula(paste0(response, " ~ N + (1 | Bloque)"))
f_P    <- as.formula(paste0(response, " ~ P + (1 | Bloque)"))
f_add  <- as.formula(paste0(response, " ~ N + P + (1 | Bloque)"))
f_int  <- as.formula(paste0(response, " ~ N * P + (1 | Bloque)"))
fits <- list(
null        = lmer(f_null, data = d, REML = FALSE),
N_only      = lmer(f_N,    data = d, REML = FALSE),
P_only      = lmer(f_P,    data = d, REML = FALSE),
additive    = lmer(f_add,  data = d, REML = FALSE),
interactive = lmer(f_int,  data = d, REML = FALSE)
)
sel <- model.sel(fits, rank = "AICc")
sel
}
selection_tables <- list()
for (sp in species_list) {
for (v in variables) {
d_sp <- dat %>% filter(specie == sp)
cat("\n---", sp, "|", v, "---\n")
sel <- tryCatch(
fit_candidate_set(d_sp, v),
error = function(e) { cat("failed:", conditionMessage(e), "\n"); NULL }
)
if (!is.null(sel)) {
print(sel)
tab <- as.data.frame(sel) %>%
mutate(
species = sp,
variable = v,
model = rownames(sel)
)
selection_tables[[paste(sp, v)]] <- tab
}
}
}
all_selection <- bind_rows(selection_tables)
write.csv(all_selection, "AICc_selection_iWUE_d13C.csv", row.names = FALSE)
best_models <- all_selection %>%
group_by(species, variable) %>%
slice_min(order_by = AICc, n = 1) %>%
select(species, variable, model, df, AICc, delta, weight)
print(best_models, n = Inf)
weight_summary <- all_selection %>%
group_by(species, variable) %>%
slice_min(order_by = AICc, n = 1) %>%
ungroup() %>%
mutate(
confidence = case_when(
weight >= 0.90 ~ "strong support for top model",
weight >= 0.50 ~ "moderate support",
TRUE           ~ "weak / ambiguous support (consider model averaging)"
)
) %>%
select(species, variable, model, weight, confidence)
print(weight_summary, n = Inf)
avg_results <- list()
for (sp in species_list) {
for (v in variables) {
d_sp <- dat %>% filter(specie == sp)
f_full <- as.formula(paste0(v, " ~ N * P + (1 | Bloque)"))
full_model <- tryCatch(
lmer(f_full, data = d_sp, REML = FALSE),
error = function(e) NULL
)
if (is.null(full_model)) next
dr <- tryCatch(dredge(full_model, rank = "AICc"), error = function(e) NULL)
if (is.null(dr)) next
conf_set <- get.models(dr, subset = delta < 4)
if (length(conf_set) < 2) next  # skip if only one model in the confidence set (no averaging needed)
avg <- model.avg(conf_set)
s <- summary(avg)
coefs <- as.data.frame(s$coefmat.full) # full-average coefficients (shrunk toward 0 for absent terms)
coefs$term <- rownames(coefs)
coefs$species <- sp
coefs$variable <- v
avg_results[[paste(sp, v)]] <- coefs
}
}
if (length(avg_results) > 0) {
all_avg <- bind_rows(avg_results)
print(all_avg, row.names = FALSE)
write.csv(all_avg, "AICc_model_averaged_coefficients.csv", row.names = FALSE)
} else {
cat("No species x variable combination had model ambiguity requiring averaging",
"(every case had a single dominant model, or dredge failed to run).\n")
}
knitr::opts_chunk$set(echo = TRUE, warning = TRUE, message = FALSE)
# install.packages(c("readxl","dplyr","lme4","lmerTest","piecewiseSEM","DiagrammeR"))
library(readxl)
library(dplyr)
library(lme4)
library(lmerTest)
library(piecewiseSEM)
install.packages("piecewiseSEM")
# install.packages(c("readxl","dplyr","lme4","lmerTest","piecewiseSEM","DiagrammeR"))
library(readxl)
library(dplyr)
library(lme4)
library(lmerTest)
library(piecewiseSEM)
#install.packages("piecewiseSEM")
raw <- read_excel("data_for_R.xlsx")
# Rename to syntactically simple names (avoids backtick clutter in formulas below)
dat <- raw %>%
rename(
iWUE   = `iWUE (μmol/mol)`,
d13C   = `δ13C (‰ v.s.V-PDB)`,
CiCa   = `Ci/Ca`,
LNC    = LNC,
LPC    = LPC,
Narea  = N_area,
Parea  = P_area,
Bloque = Bloque,
Naddition = N,
Paddition = P
) %>%
mutate(
Bloque = factor(Bloque),
Naddition = factor(Naddition),
Paddition = factor(Paddition),
specie = as.character(specie)
)
# quick species table
dat %>% count(specie, sort = TRUE)
# Full mediator set: LNC + LPC as parallel mediators, direct + indirect paths to iWUE and d13C,
# plus a residual correlation between the two physiological outcomes.
build_psem_full <- function(d) {
m_LNC  <- lmer(LNC  ~ Naddition + Paddition + (1 | Bloque), data = d, REML = TRUE)
m_LPC  <- lmer(LPC  ~ Naddition + Paddition + (1 | Bloque), data = d, REML = TRUE)
m_iWUE <- lmer(iWUE ~ Naddition + Paddition + LNC + LPC + (1 | Bloque), data = d, REML = TRUE)
m_d13C <- lmer(d13C ~ Naddition + Paddition + LNC + LPC + (1 | Bloque), data = d, REML = TRUE)
psem(
m_LNC, m_LPC, m_iWUE, m_d13C,
iWUE %~~% d13C,   # correlated residuals: same-leaf physiological covariance not explained by the model
data = d
)
}
# Simplified mediator set for small-n species (n < 25): single mediator (LNC) only,
# to keep each regression's df reasonable given only 4 blocks.
build_psem_simple <- function(d) {
m_LNC  <- lmer(LNC  ~ Naddition + Paddition + (1 | Bloque), data = d, REML = TRUE)
m_iWUE <- lmer(iWUE ~ Naddition + Paddition + LNC + (1 | Bloque), data = d, REML = TRUE)
m_d13C <- lmer(d13C ~ Naddition + Paddition + LNC + (1 | Bloque), data = d, REML = TRUE)
psem(
m_LNC, m_iWUE, m_d13C,
iWUE %~~% d13C,
data = d
)
}
